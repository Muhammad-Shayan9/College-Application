@model List<College_Application.Models.Course>

@{
    ViewData["Title"] = "Manage Courses";
    Layout = "~/Views/Shared/_AdminPanel.cshtml";
}

<h2 class="h3 mb-2 text-gray-800 text-center">Manage Courses</h2>

<a asp-action="Create" class="btn btn-success mb-3">Add New Course</a>

<div class="table-responsive">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Image</th>
                <th>Title</th>
                <th>Description</th>
                <th style="width: 180px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(course.ImagePath))
                        {
                            <img src="@course.ImagePath" alt="@course.Title" width="80" />
                        }
                        else
                        {
                            <img src="~/images/default-course.png" alt="No Image" width="80" />
                        }
                </td>
                <td>@course.Title</td>
                <td>
                    @(course.Description != null && course.Description.Length > 50
                                        ? course.Description.Substring(0, 50) + "..."
                                        : course.Description)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@course.Id"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Are you sure you want to delete this course?');">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
