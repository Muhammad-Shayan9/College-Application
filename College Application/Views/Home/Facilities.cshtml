
@{
    ViewData["Title"] = "Facilities";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-title" data-aos="fade">
    <div class="heading">
        <div class="container">
            <div class="row d-flex justify-content-center text-center">
                <div class="col-lg-8">
                    <h1>Facilities</h1>
                    <p class="mb-0">
                        Equipped with modern labs, smart classrooms, our campus provides a safe and inspiring environment for learning.
                        We combine technology, comfort, and student support to faster academic excellence and personal growth.
                    </p>
                </div>
            </div>
        </div>
    </div>
    <div data-aos="fade" class="faculty-heading text-center my-5" style="background-color: #f0fdf4; padding: 50px 20px; border-radius: 12px; box-shadow: 0 4px 10px rgba(0, 128, 0, 0.1);">
        <h2 style="color: #16a34a; font-size: 3rem; font-weight: 600; letter-spacing: 1px;">
            Academic Facilities
        </h2>
    </div>

    
</div>

<section id="events" class="events section">
    

    <div class="container" data-aos="fade-up">

        <div class="row">
            <div class="col-md-6 d-flex align-items-stretch">
                <div class="card">
                    <div class="card-img">
                        <img src="~/User/img/Classroom.png" alt="...">
                    </div>
                    <div class="card-body">
                        <h5 class="card-title"><a>Modern Classroom</a></h5>
                        <p class="card-text">Experience our bright, modern classrooms designed for effective learning. Spacious desks, ergonomic chairs, and large windows create a comfortable environment, while whiteboards and projectors ensure seamless teaching and interactive sessions.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 d-flex align-items-stretch">
                <div class="card">
                    <div class="card-img">
                        <img src="~/User/img/ComputerLab.png" alt="...">
                    </div>
                    <div class="card-body">
                        <h5 class="card-title"><a>Computer Labs</a></h5>
                        <p class="card-text">Explore our modern computer lab, equipped with state-of-the-art desktops and ergonomic chairs. Bright, spacious, and tech-ready, it provides an ideal environment for practical learning, coding, and collaborative projects.</p>
                    </div>
                </div>

            </div>
        </div>

        <div class="row">
            <div class="col-md-6 d-flex align-items-stretch">
                <div class="card">
                    <div class="card-img">
                        <img src="~/User/img/Library.png" alt="...">
                    </div>
                    <div class="card-body">
                        <h5 class="card-title"><a>Library</a></h5>
                        <p class="card-text">Our modern college library offers a bright and spacious environment for study and research. With well-organized bookshelves, comfortable seating, and natural light, it provides the perfect setting for reading, group study, and academic exploration.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 d-flex align-items-stretch">
                <div class="card">
                    <div class="card-img">
                        <img src="~/User/img/workshops.png" alt="...">
                    </div>
                    <div class="card-body">
                        <h5 class="card-title"><a>Workshops / Practical Labs</a></h5>
                        <p class="card-text">Our state-of-the-art workshops and practical labs provide hands-on learning for students. Equipped with advanced tools, robotics, and project stations, these labs foster collaboration, innovation, and practical skill development in a safe and well-lit environment.</p>
                    </div>
                </div>

            </div>
        </div>

    </div>
    <div data-aos="fade" class="faculty-heading text-center my-5" style="background-color: #f0fdf4; padding: 50px 20px; border-radius: 12px; box-shadow: 0 4px 10px rgba(0, 128, 0, 0.1);">
        <h2 style="color: #16a34a; font-size: 3rem; font-weight: 600; letter-spacing: 1px;">
            Technology & IT
        </h2>
    </div>
    <div class="container" data-aos="fade-up">

        <div class="row">
            <div class="col-md-6 d-flex align-items-stretch">
                <div class="card">
                    <div class="card-img">
                        <img src="~/User/img/wifi.png" alt="...">
                    </div>
                    <div class="card-body">
                        <h5 class="card-title"><a>Wi-Fi Campus</a></h5>
                        <p class="card-text">Our campus offers seamless Wi-Fi connectivity across all areas, enabling students to stay connected and productive. Students can work on laptops, tablets, or smartphones outdoors or in common areas, supporting research, collaboration, and online learning anytime, anywhere.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 d-flex align-items-stretch">
                <div class="card">
                    <div class="card-img">
                        <img src="~/User/img/SmartBoards.png" alt="...">
                    </div>
                    <div class="card-body">
                        <h5 class="card-title"><a>Smart Boards / Projectors</a></h5>
