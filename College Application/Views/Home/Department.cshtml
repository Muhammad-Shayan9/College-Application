
@{
    ViewData["Title"] = "Department";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-title" data-aos="fade">
    <div class="heading">
        <div class="container">
            <div class="row d-flex justify-content-center text-center">
                <div class="col-lg-8">
                    <h1>DEPARTMENTS</h1>
                    <p class="mb-0">
                        Explore our diverse academic departments designed to build your future.
                        Our institution offers a wide range of academic disciplines that focus on knowledge, innovation, and practical skills.
                        Each department is committed to academic excellence, modern learning approaches, and student success.
                        We prepare learners to meet future challenges with confidence and competence.
                    </p>
                </div>
            </div>
        </div>
    </div>
    <div data-aos="fade" class="faculty-heading text-center my-5" style="background-color: #f0fdf4; padding: 50px 20px; border-radius: 12px; box-shadow: 0 4px 10px rgba(0, 128, 0, 0.1);">
        <h2 style="color: #16a34a; font-size: 3rem; font-weight: 600; letter-spacing: 1px;">
            DEPARTMENTS OF OUR COLLEGE
        </h2>
    </div>


</div>
<section id="events" class="events section">
<div class="container" data-aos="fade-up">

    <div class="row">
        <div class="col-md-6 d-flex align-items-stretch">
            <div class="card">
                <div class="card-img">
                    <img src="~/User/img/Computer Science.png" alt="...">
                </div>
                <div class="card-body">
                    <h5 class="card-title"><a>Department of Computer Science 💻</a></h5>
                    <p class="card-text">
                        The Department of Computer Science focuses on building strong foundations in computing and programming.
                        Students develop problem-solving, analytical, and technical skills through theory and practical learning.
                        The department emphasizes modern technologies and hands-on experience.
                        Our aim is to prepare students for careers in technology and higher education.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-6 d-flex align-items-stretch">
            <div class="card">
                <div class="card-img">
                    <img src="~/User/img/Pre-Eng.png" alt="...">
                </div>
                <div class="card-body">
                    <h5 class="card-title"><a>Department of Pre-Engineering ⚙️</a></h5>
                    <p class="card-text">
                        The Department of Pre-Engineering provides a solid academic base in mathematics, physics, and engineering concepts.
                        It prepares students for higher studies in various engineering disciplines.
                        The department focuses on analytical thinking and problem-solving skills.
                        Students are guided to meet future challenges in engineering and technology.
                    </p>
                </div>
            </div>

        </div>
    </div>

    <div class="row">
        <div class="col-md-6 d-flex align-items-stretch">
            <div class="card">
                <div class="card-img">
                    <img src="~/User/img/Art.png" alt="...">
                </div>
                <div class="card-body">
                    <h5 class="card-title"><a>Department of Arts 🎨</a></h5>
                    <p class="card-text">
                        The Department of Arts fosters creativity, imagination, and critical thinking among students.
                        It offers hands-on experience in painting, sculpture, design, and other artistic disciplines.
                        Students are encouraged to explore their talents and develop unique styles.
                        The department prepares learners for careers in creative fields and higher studies in art and design.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-6 d-flex align-items-stretch">
            <div class="card">
                <div class="card-img">
                    <img src="~/User/img/Dep-Medical.png" alt="...">
                </div>
                <div class="card-body">
                    <h5 class="card-title"><a>Department of Medical 🩺</a></h5>
                    <p class="card-text">
                        The Department of Medical provides practical training and foundational knowledge for future healthcare professionals.
                        Students engage in hands-on learning, including patient care, diagnostics, and medical procedures.
                        The department emphasizes clinical skills, critical thinking, and ethical practice.
                        It prepares students for careers in medicine, healthcare, and allied medical sciences.
                    </p>
                </div>
            </div>

        </div>
    </div>

</div>
</section>
