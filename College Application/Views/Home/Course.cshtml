@model List<College_Application.Models.Course>

@{
    ViewData["Title"] = "Courses";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="main">

    <!-- Page Title -->
    <div class="page-title" data-aos="fade">
        <div class="heading">
            <div class="container">
                <div class="row d-flex justify-content-center text-center">
                    <div class="col-lg-8">
                        <h1>Courses</h1>
                        <p>Explore our wide range of programs designed to help you achieve academic excellence and build a successful career.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Courses Section -->
    <section id="courses" class="courses section">
        <div class="container" data-aos="fade-up">
            <div class="row">
                @for (int i = 0; i < (Model?.Count ?? 0); i++)
                {
                    var course = Model[i];

                    <div class="col-lg-4 col-md-6 mb-4" data-aos="zoom-in" data-aos-delay="@(i * 100)">
                        <div class="course-item text-center p-3 rounded shadow-sm bg-white d-flex flex-column">
                            <img src="@course.ImagePath" class="img-fluid mb-3 rounded"
                                 alt="@course.Title" style="max-height:180px; object-fit:cover;" />

                            <h3 class="mb-3">@course.Title</h3>

                            <button class="btn btn-sm btn-primary rounded-pill px-4 py-2 mb-3"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#course-@i"
                                    aria-controls="course-@i">
                                More Info
                            </button>

                            <div class="collapse mt-2" id="course-@i">
                                <p class="description px-3 py-3 rounded">
                                    @course.Description
                                </p>
                            </div>
                        </div>
                    </div>

                }



            </div>
        </div>
    </section>
</main>

<style>

/* Course More Info Button */
.courses .btn-primary {
    background-color: #2ecc71; /* Accent Green */
    border-color: #2ecc71;
    color: #ffffff;
    padding: 6px 18px;
    border-radius: 25px;
    font-size: 14px;
    transition: all 0.3s ease;
}

.courses .btn-primary:hover {
    background-color: #27ae60;
    border-color: #27ae60;
    color: #ffffff;
}

/* Collapse tweaks */
.collapse {
    display: block; 
    overflow: hidden;
}

.collapse.show {
    height: auto !important; 
}

/* Description inside collapse */
.courses .description {
    color: #34495e;
    font-size: 0.95rem;
    line-height: 1.5;
    background-color: #f0f8ff;
    box-shadow: inset 0 0 8px #7ec8ff;
    margin: 0; /* optional: padding already applied */
}

    /* ===== Course Card Professional Styling ===== */

    .course-item {
        border-radius: 18px;
        border: 1px solid rgba(0, 0, 0, 0.06);
        transition: all 0.35s ease;
        background: var(--background-color);
    }

        .course-item:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
        }

        /* Image styling */
        .course-item img {
            border-radius: 14px;
            transition: transform 0.4s ease;
        }

        .course-item:hover img {
            transform: scale(1.05);
        }

        /* Title */
        .course-item h3 {
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--default-color);
        }

        /* Button */
        .course-item .btn {
            background-color: var(--accent-color);
            border: none;
            color: var(--contrast-color);
            transition: all 0.3s ease;
        }

            .course-item .btn:hover {
                opacity: 0.9;
                transform: scale(1.05);
            }

        /* Description */
        .course-item .description {
            background: #f8f9fa;
            font-size: 0.95rem;
            line-height: 1.6;
            color: #555;
        }

    /* Equal height cards */
    .course-item {
        height: 100%;
    }

</style>

    




