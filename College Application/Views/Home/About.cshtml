
@{
    ViewData["Title"] = "About";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Title -->
<div class="page-title" data-aos="fade">
    <div class="heading">
        <div class="container">
            <div class="row d-flex justify-content-center text-center">
                <div class="col-lg-8">
                    <h1>About Us<br></h1>
                    <p class="mb-0">
                        ITM College is dedicated to providing quality education and a nurturing environment for all students.
                        Our mission is to empower learners with knowledge, skills, and values to excel in their academic and professional journeys.
                        We focus on fostering innovation, critical thinking, and personal growth while preparing students to contribute positively to society.
                    </p>

                </div>
            </div>
        </div>
    </div>
</div><!-- End Page Title -->
<!-- About Us Section -->
<section id="about-us" class="section about-us">

    <div class="container">

        <div class="row gy-4">

            <div class="col-lg-6 order-1 order-lg-2" data-aos="fade-up" data-aos-delay="100">
                <img src="~/User/img/about-2.jpg" class="img-fluid" alt="">
            </div>

            <div class="col-lg-6 order-2 order-lg-1 content" data-aos="fade-up" data-aos-delay="200">
                <h3>Our Mission and Values</h3>
                <p class="fst-italic">
                    At ITM College, we are committed to providing a supportive and innovative learning environment
                    where students can excel academically and grow personally.
                </p>
                <ul>
                    <li><i class="bi bi-check-circle"></i> <span>Deliver high-quality education that prepares students for successful careers.</span></li>
                    <li><i class="bi bi-check-circle"></i> <span>Foster creativity, critical thinking, and lifelong learning in every student.</span></li>
                    <li><i class="bi bi-check-circle"></i> <span>Provide opportunities for personal development, research, and community engagement to shape responsible global citizens.</span></li>
                </ul>

            </div>

        </div>

    </div>

</section>

