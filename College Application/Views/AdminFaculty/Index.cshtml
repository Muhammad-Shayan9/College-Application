@model List<College_Application.Models.Faculty>

@{
    ViewData["Title"] = "Manage Faculty";
    Layout = "~/Views/Shared/_AdminPanel.cshtml";
}

<h2 class="h3 mb-2 text-gray-800 text-center">Manage Faculty</h2>

<a asp-action="Create" class="btn btn-success mb-3">Add New Faculty</a>

<div class="table-responsive">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Image</th>
                <th>Title</th>
                <th>Description</th>
                <th style="width: 180px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var faculty in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(faculty.ImagePath))
                        {
                            <img src="@faculty.ImagePath" alt="@faculty.Title" width="80" />
                        }
                        else
                        {
                            <img src="~/images/default-user.png" alt="No Image" width="80" />
                        }
                </td>

                <td>@faculty.Title</td>

                <td>
                    @(faculty.Description != null && faculty.Description.Length > 50
                                        ? faculty.Description.Substring(0, 50) + "..."
                                        : faculty.Description)
                    </td>

                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@faculty.Id"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@faculty.Id"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Are you sure you want to delete this faculty?');">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
