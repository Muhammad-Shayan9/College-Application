@model List<College_Application.Models.Event>

@{
    ViewData["Title"] = "Manage Events";
    Layout = "~/Views/Shared/_AdminPanel.cshtml";
}

<h2 class="h3 mb-2 text-gray-800 text-center">Manage Events</h2>

<a asp-action="Create" class="btn btn-success mb-3">Add New Event</a>

<div class="table-responsive">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Image</th>
                <th>Title</th>
                <th>Description</th>
                <th style="width: 180px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ev in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(ev.ImagePath))
                        {
                            <img src="@ev.ImagePath" alt="@ev.Title" width="80" />
                        }
                        else
                        {
                            <img src="~/images/default-event.png" alt="No Image" width="80" />
                        }
                </td>

                <td>@ev.Title</td>

                <td>
                    @(ev.Description != null && ev.Description.Length > 50
                                        ? ev.Description.Substring(0, 50) + "..."
                                        : ev.Description)
                    </td>

                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@ev.Id"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@ev.Id"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Are you sure you want to delete this event?');">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
