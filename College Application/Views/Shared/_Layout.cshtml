<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - College_Application</title>
    <script type="importmap"></script>
    <link href="~/User/img/FavIcon Green.png" rel="icon">
    <link href="~/User/img/apple-touch-icon.png" rel="apple-touch-icon">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />


    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700;1,800&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="~/User/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/User/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/User/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/User/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="~/User/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

    <!-- Main CSS File -->
    <link href="~/User/css/main.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css">

</head>
<body>

    <header id="header" class="header d-flex align-items-center sticky-top">

        <div class="container-fluid container-xl position-relative d-flex align-items-center">

            <!-- LOGO -->
            <a asp-controller="Home"
               asp-action="Index"
               class="logo d-flex align-items-center me-auto">

                <h1 class="sitename">ITM College</h1>

            </a>


            <!-- MOBILE MENU BUTTON -->
            <button type="button"
                    class="mobile-nav-toggle"
                    aria-label="Toggle navigation"
                    aria-controls="navmenu"
                    aria-expanded="false">

                <i class="bi bi-list"></i>

            </button>


            <!-- NAVIGATION -->
            <nav id="navmenu" class="navmenu">

                <ul>

                    <!-- HOME -->
                    <li>
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="active">
                            Home
                        </a>
                    </li>


                    <!-- MORE -->
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle">
                            More
                            <i class="bi bi-chevron-down"></i>
                        </a>

                        <ul>
                            <li>
                                <a asp-controller="Home" asp-action="Course">Course</a>
                            </li>
                            <li>
                                <a asp-controller="Home" asp-action="Department">Department</a>
                            </li>
                            <li>
                                <a asp-controller="Home" asp-action="Faculty">Faculty</a>
                            </li>
                            <li>
                                <a asp-controller="Home" asp-action="Facilities">Facilities</a>
                            </li>
                            <li>
                                <a asp-controller="Home" asp-action="Event">Events</a>
                            </li>
                        </ul>
                    </li>


                    <!-- ONLINE ADMISSION -->
                    <li>
                        <a asp-controller="Admission"
                           asp-action="AdmissionForm">
                            Online Admission
                        </a>
                    </li>


                    <!-- INFO -->
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle">
                            Info
                            <i class="bi bi-chevron-down"></i>
                        </a>

                        <ul>
                            <li>
                                <a asp-controller="Home" asp-action="Contact">Contact Us</a>
                            </li>
                            <li>
                                <a asp-controller="Home" asp-action="About">About</a>
                            </li>
                        </ul>
                    </li>


                    <!-- LOGIN / REGISTER -->
                    <partial name="_LoginPartial" />

                </ul>

            </nav>

        </div>

    </header>



    <main role="main">
        @RenderBody()
    </main>


    <footer id="footer" class="footer position-relative light-background">

        <div class="container footer-top">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6 footer-about">
                    <a href="index.html" class="logo d-flex align-items-center">
                        <span class="sitename">ITM College</span>
                    </a>
                    <div class="footer-contact pt-3">
                        <p>Pakistan Karachi Street</p>
                        <p>MA Jinnah Road</p>
                        <p class="mt-3"><strong>Phone:</strong> <span>+92 3303 431298</span></p>
                        <p><strong>Email:</strong> <span>shayann9988@gmail.com</span></p>
                    </div>
                    <div class="social-links d-flex mt-4">
                        <a href="" target="_blank" rel="noopener">
                            <i class="bi bi-twitter-x"></i>
                        </a>

                        <a href="https://facebook.com/Muhammad-Shayan" target="_blank" rel="noopener">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="https://www.instagram.com/priv.__.shayan" target="_blank" rel="noopener">
                            <i class="bi bi-instagram"></i>
                        </a>

                        <a href="https://www.linkedin.com/in/muhammad-shayan-220017361/" target="_blank" rel="noopener">
                            <i class="bi bi-linkedin"></i>
                        </a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>Forms</h4>
                    <ul>
                        <li><a asp-controller="Admission" asp-action="AdmissionForm" >Online Admission</a></li>
                        <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact Us</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>Our Institution</h4>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Course">Courses</a></li>
                        <li><a  asp-controller="Home" asp-action="Department">Department</a></li>
                        <li><a  asp-controller="Home" asp-action="Faculty">Faculty</a></li>
                        <li><a  asp-controller="Home" asp-action="Facilities">Facilites</a></li>
                        <li><a asp-controller="Home" asp-action="Event">Event</a></li>
                    </ul>
                </div>
                
                <div class="col-lg-4 col-md-12 footer-newsletter">
                    <h4>Why ITM College?</h4>
                    <p>
                        ITM College is committed to academic excellence,
                        experienced faculty, and a supportive learning environment
                        to help students achieve their goals.
                    </p>
                </div>

            </div>
        </div>
        <div class="container-fluid border-top mt-4" style="background-color: var(--background-color);">
            <div class="container">
                <div class="row">
                    <div class="col-12 text-center py-3">
                        <small style="color: var(--default-color);">
                            © <span id="year"></span> This Website is Created by
                            <strong>Muhammad Shayan</strong>
                        </small>
                    </div>
                </div>
            </div>
        </div>



    </footer>

    <div id="preloader"></div>

    <!-- Vendor JS Files -->
    <script src="~/User/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/User/vendor/php-email-form/validate.js"></script>
    <script src="~/User/vendor/aos/aos.js"></script>
    <script src="~/User/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/User/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="~/User/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>

    <!-- Main JS File -->
    <script src="~/User/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <script>
        AOS.init({
            once: true,       
            duration: 800,    
            easing: 'ease-in-out'
        });

    </script>
    @* Ye Home page Counter ka comment hai *@
    <script src="https://cdn.jsdelivr.net/npm/purecounterjs@1.5.0/dist/purecounter_vanilla.js"></script>
    <script>
        new PureCounter();
    </script>
        @* Ye Home page teacher experience ka comment hai *@

    <script>
        document.addEventListener('DOMContentLoaded', function () {
          new Swiper('.init-swiper', {
            loop: true,
            speed: 600,
            autoplay: {
              delay: 3000,
              disableOnInteraction: false
            },
            slidesPerView: 1,
            spaceBetween: 30,
            pagination: {
              el: '.swiper-pagination',
              clickable: true
            },
            breakpoints: {
              768: {
                slidesPerView: 2
              }
            }
          });
        });
    </script>
    <script>
        const preloader = document.querySelector('#preloader');

        if (preloader) {
          window.addEventListener('load', () => {
            setTimeout(() => {
              preloader.remove();
            }, 400); // 1 second delay
          });
        }
    </script>




</body>
</html>
