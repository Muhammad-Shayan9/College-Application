@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container">
<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">


            <div class="card-header text-center py-3"
                 style="background-color: var(--accent-color); color: var(--contrast-color);">
                <h4 class="mb-0">Create New Account</h4>
            </div>

            <div class="card-body p-4"
                 style="background-color: var(--background-color);">

                <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    @if(!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All"class="alert alert-danger py-2"></div>                           
                    }

                    

                    <div class="form-group mb-3">
                        <label asp-for="Input.FullName"
                               class="form-label fw-semibold"
                               style="color: var(--default-color);"></label>

                        <input asp-for="Input.FullName"
                               class="form-control form-control-lg"
                               autocomplete="name"
                               aria-required="true" />
                        <span asp-validation-for="Input.FullName"
                              class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Input.DateOfBirth"
                               class="form-label fw-semibold"
                               style="color: var(--default-color);"></label>

                        <input asp-for="Input.DateOfBirth"
                               type="date"
                               class="form-control form-control-lg"
                               aria-required="true" />
                        <span asp-validation-for="Input.DateOfBirth"
                              class="text-danger small"></span>
                    </div>




                    <div class="form-group mb-3">
                        <label asp-for="Input.Email"
                               class="form-label fw-semibold"
                               style="color: var(--default-color);"></label>

                        <input asp-for="Input.Email"
                               class="form-control form-control-lg"
                               autocomplete="username"
                               aria-required="true" />
                        <span asp-validation-for="Input.Email"
                              class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Input.Password"
                               class="form-label fw-semibold"
                               style="color: var(--default-color);"></label>

                        <input asp-for="Input.Password"
                               class="form-control form-control-lg"
                               autocomplete="new-password"
                               aria-required="true" />
                        <span asp-validation-for="Input.Password"
                              class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Input.ConfirmPassword"
                               class="form-label fw-semibold"
                               style="color: var(--default-color);"></label>

                        <input asp-for="Input.ConfirmPassword"
                               class="form-control form-control-lg"
                               autocomplete="new-password"
                               aria-required="true" />
                        <span asp-validation-for="Input.ConfirmPassword"
                              class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit"
                                class="btn btn-lg"
                                style="
                                    background-color: var(--accent-color);
                                    color: var(--contrast-color);
                                    border-radius: 50px;
                                ">
                            Register
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>
</div>



    

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
