@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Recovery codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">

            <div class="card-header text-center py-3"
                 style="background-color: var(--accent-color); color: var(--contrast-color); font-weight: 600;">
                <h4 class="mb-0">@ViewData["Title"]</h4>
            </div>

            <partial name="_StatusMessage" for="StatusMessage" />

            <div class="card-body p-4" style="background-color: var(--background-color);">
                <div class="alert alert-warning" role="alert">
                    <p><strong>Put these codes in a safe place.</strong></p>
                    <p>If you lose your device and don't have the recovery codes you will lose access to your account.</p>
                </div>

                <div class="d-flex flex-wrap justify-content-start mb-3">
                    @for (var i = 0; i < Model.RecoveryCodes.Length; i++)
                    {
                        <code class="recovery-code m-1 p-2 rounded border"
                              style="background-color: var(--background-color); border: 1px solid var(--accent-color);">
                            @Model.RecoveryCodes[i]
                        </code>
                    }
                </div>

                <div class="d-grid">
                    <a asp-page="./GenerateRecoveryCodes" class="btn btn-lg rounded-pill"
                       style="background-color: var(--accent-color); color: var(--contrast-color);">
                        Generate New Recovery Codes
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
