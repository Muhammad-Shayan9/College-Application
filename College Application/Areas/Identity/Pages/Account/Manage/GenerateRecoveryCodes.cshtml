@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generate two-factor authentication (2FA) recovery codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">

            <div class="card-header text-center py-3"
                 style="background-color: var(--accent-color); color: var(--contrast-color); font-weight: 600;">
                <h4 class="mb-0">@ViewData["Title"]</h4>
            </div>

            <partial name="_StatusMessage" for="StatusMessage" />

            <div class="card-body p-4" style="background-color: var(--background-color);">
                <div class="alert alert-warning">
                    <p>
                        <strong>⚠ Put these codes in a safe place.</strong>
                    </p>
                    <p>
                        If you lose your device and don't have the recovery codes you will lose access to your account.
                    </p>
                    <p>
                        Generating new recovery codes does not change the keys used in authenticator apps. If you wish to change the key
                        used in an authenticator app you should <a asp-page="./ResetAuthenticator">reset your authenticator keys.</a>
                    </p>
                </div>

                <form method="post" class="form-group">
                    <div class="d-grid mb-3">
                        <button class="btn btn-danger btn-lg rounded-pill" type="submit">Generate Recovery Codes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
