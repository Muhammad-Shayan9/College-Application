@page
@model TwoFactorAuthenticationModel

@{
    ViewData["Title"] = "Two-factor authentication (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 text-center">
            <!-- Added text-center -->

            <div class="card-header py-3"
                 style="background-color: var(--accent-color); color: var(--contrast-color);">
                <h4 class="mb-0">@ViewData["Title"]</h4>
            </div>

            <div class="card-body p-4" style="background-color: var(--background-color);">

                <partial name="_StatusMessage" for="StatusMessage" />

                @if (Model.Is2faEnabled)
                {
                    @* Recovery codes alerts *@
                    @if (Model.RecoveryCodesLeft == 0)
                    {
                        <div class="alert alert-danger text-center">
                            <strong>You have no recovery codes left.</strong>
                            <p>You must <a asp-page="./GenerateRecoveryCodes">generate a new set of recovery codes</a> before you can log in with a recovery code.</p>
                        </div>
                    }
                    else if (Model.RecoveryCodesLeft == 1)
                    {
                        <div class="alert alert-danger text-center">
                            <strong>You have 1 recovery code left.</strong>
                            <p>You can <a asp-page="./GenerateRecoveryCodes">generate a new set of recovery codes</a>.</p>
                        </div>
                    }
                    else if (Model.RecoveryCodesLeft <= 3)
                    {
                        <div class="alert alert-warning text-center">
                            <strong>You have @Model.RecoveryCodesLeft recovery codes left.</strong>
                            <p>You should <a asp-page="./GenerateRecoveryCodes">generate a new set of recovery codes</a>.</p>
                        </div>
                    }

                    <div class="d-flex flex-wrap justify-content-center gap-2 mb-3">
                        @if (Model.IsMachineRemembered)
                        {
                            <form method="post" style="display:inline-block">
                                <button type="submit"
                                        class="btn btn-lg"
                                        style="
                                                        background-color: var(--accent-color);
                                                        color: var(--contrast-color);
                                                        border-radius: 50px;">
                                    Forget this browser
                                </button>
                            </form>
                        }
                        <a asp-page="./Disable2fa"
                           class="btn btn-lg"
                           style="
                                        background-color: var(--accent-color);
                                        color: var(--contrast-color);
                                        border-radius: 50px;">
                            Disable 2FA
                        </a>
                        <a asp-page="./GenerateRecoveryCodes"
                           class="btn btn-lg"
                           style="
                                        background-color: var(--accent-color);
                                        color: var(--contrast-color);
                                        border-radius: 50px;">
                            Reset recovery codes
                        </a>
                    </div>
                }

                <h5 class="mt-4">Authenticator app</h5>
                <div class="d-flex flex-wrap justify-content-center gap-2 mb-3">
                    @if (!Model.HasAuthenticator)
                    {
                        <a id="enable-authenticator"
                           asp-page="./EnableAuthenticator"
                           class="btn btn-lg"
                           style="
                                        background-color: var(--accent-color);
                                        color: var(--contrast-color);
                                        border-radius: 50px;">
                            Add authenticator app
                        </a>
                    }
                    else
                    {
                        <a id="enable-authenticator"
                           asp-page="./EnableAuthenticator"
                           class="btn btn-lg"
                           style="
                                        background-color: var(--accent-color);
                                        color: var(--contrast-color);
                                        border-radius: 50px;">
                            Setup authenticator app
                        </a>
                        <a id="reset-authenticator"
                           asp-page="./ResetAuthenticator"
                           class="btn btn-lg"
                           style="
                                        background-color: var(--accent-color);
                                        color: var(--contrast-color);
                                        border-radius: 50px;">
                            Reset authenticator app
                        </a>
                    }
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
