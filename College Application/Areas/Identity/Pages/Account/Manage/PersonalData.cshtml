@page
@model PersonalDataModel

@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">

            <div class="card-header text-center py-3"
                 style="background-color: var(--accent-color); color: var(--contrast-color);">
                <h4 class="mb-0">@ViewData["Title"]</h4>
            </div>

            <div class="card-body p-4" style="background-color: var(--background-color);">

                <p>Your account contains personal data that you have given us. This page allows you to download or delete that data.</p>

                <p>
                    <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
                </p>

                <div class="d-flex flex-wrap gap-2 mt-3">
                    <form id="download-data" asp-page="DownloadPersonalData" method="post" class="m-0">
                        <button type="submit" class="btn btn-lg"
                                style="background-color: var(--accent-color); color: var(--contrast-color); border-radius: 50px;">
                            Download
                        </button>
                    </form>

                    <a id="delete"
                       role="button"
                       asp-page="DeletePersonalData"
                       class="btn btn-lg"
                       style="background-color: var(--accent-color); color: var(--contrast-color); border-radius: 50px;">
                        Delete
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
