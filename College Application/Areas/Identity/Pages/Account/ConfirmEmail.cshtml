@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm Email";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">

            <!-- Card Header -->
            <div class="card-header text-center py-3"
                 style="background-color: var(--accent-color); color: var(--contrast-color);">
                <h4 class="mb-0">Confirm Your Email</h4>
            </div>

            <!-- Card Body -->
            <div class="card-body p-4" style="background-color: var(--background-color); text-align:center;">

                <!-- Status Message -->
                @if (Model.StatusMessage != null)
                {
                    <div class="alert alert-success py-2">
                        @Model.StatusMessage
                    </div>
                }
                else
                {
                    <div class="alert alert-danger py-2">
                        Sorry, email confirmation failed.
                    </div>
                }

               
                <!-- Navigation Links -->
                <div class="mt-4">
                    <p>
                        <a asp-page="/Index"
                           class="btn btn-outline-success me-2"
                           style="width:48%;">Go to Home</a>
                        <a asp-page="/Account/Login"
                           class="btn btn-outline-success"
                           style="width:48%;">Login</a>
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Optional CSS Variables -->
<style>
    :root {
        --accent-color: #28a745; /* green accent */
        --contrast-color: #fff; /* text color on accent */
        --background-color: #f9fdf9; /* soft light background */
    }

    .btn-outline-success {
        color: var(--accent-color);
        border-color: var(--accent-color);
    }

        .btn-outline-success:hover {
            background-color: var(--accent-color);
            color: var(--contrast-color);
        }
</style>
