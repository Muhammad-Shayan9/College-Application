@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend Email Confirmation";
}

<div class="auth-background">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-md-4">

            <div class="card shadow border-0">

                <div class="card-header text-center py-3"
                     style="background-color: var(--accent-color); color: var(--contrast-color);">
                    <h4 class="mb-0">Resend Email Confirmation</h4>
                </div>

                <div class="card-body p-4"
                     style="background-color: var(--background-color);">

                    <p class="text-muted text-center mb-4">
                        Enter your registered email address to receive a new confirmation link.
                    </p>

                    <form method="post">

                        @if(!ViewData.ModelState.IsValid)
                        {
                        <div asp-validation-summary="All"
                             class="alert alert-danger py-2"></div>
                        }
                        

                        <div class="form-group mb-4">
                            <label asp-for="Input.Email"
                                   class="form-label fw-semibold"
                                   style="color: var(--default-color);"></label>

                            <input asp-for="Input.Email"
                                   class="form-control form-control-lg"
                                   autocomplete="email"
                                   aria-required="true" />

                            <span asp-validation-for="Input.Email"
                                  class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit"
                                    class="btn btn-lg"
                                    style="
                                        background-color: var(--accent-color);
                                        color: var(--contrast-color);
                                        border-radius: 50px;
                                    ">
                                Resend Confirmation
                            </button>
                        </div>

                        <div class="text-center mt-3">
                            <a asp-page="./Login"
                               class="text-decoration-none fw-semibold"
                               style="color: var(--accent-color);">
                                Back to Login
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
